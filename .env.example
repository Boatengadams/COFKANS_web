# App environment:
#   development = live Firebase backend for local testing
#   production  = live Firebase backend for production exports
EXPO_PUBLIC_APP_ENV=development

# Firebase web app config. These are public client identifiers from
# Firebase Console > Project settings > General > Your apps > Web app.
#
# Local development should use the staging Firebase project's web app values:
#   cofkans-staging
# Production builds should set these same variable names from the production
# Firebase project's web app values:
#   cofkanselectricals-app
#
# Keep service account JSON keys out of this file. Store them locally at:
#   ~/.config/cofkans-firebase-keys/staging.json
#   ~/.config/cofkans-firebase-keys/production.json
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Supabase public storage config. The public media bucket is
# COFKANSELECTRICALS and stores product, category, and site media.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# App Check reCAPTCHA v3 site key.
EXPO_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Developer portal gate.
EXPO_PUBLIC_DEVELOPER_EMAIL=

# Payments.
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Local Firebase Emulator Suite (Auth + Firestore + Functions).
# Keep unset / false for normal local-dev against live staging.
# Only set true when running `pnpm emulators` + `pnpm dev:customer:emulators`.
# Hard-gated in code: ignored in production builds and non-localhost hosts.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
