  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "vite --host 0.0.0.0",
    "dev:customer": "./node_modules/.bin/vite --host 0.0.0.0 --config apps/customer/vite.config.ts",
    "dev:staff": "cd \"../COFKANS_Staff \" && ./node_modules/.bin/vite --host 0.0.0.0",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build:web": "expo export --platform web",
    "export": "expo export",
    "figma:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:customer": "./node_modules/.bin/vite build --config apps/customer/vite.config.ts",
    "build:staff": "cd \"../COFKANS_Staff \" && ./node_modules/.bin/vite build",
    "preview": "vite preview",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
