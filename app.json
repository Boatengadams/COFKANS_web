{
  "expo": {
    "name": "Cofkans Electricals",
    "slug": "cofkans-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cofkans",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/imports/cofkans.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf9ff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cofkans.mobile"
    },
    "android": {
      "package": "com.cofkans.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#fbf9ff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./src/imports/Cofkans_FavIcon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/imports/cofkans.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#fbf9ff",
          "dark": {
            "image": "./src/imports/cofkans.png",
            "backgroundColor": "#201535"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "./app"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
